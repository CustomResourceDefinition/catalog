{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "networkRef",
        "type"
      ],
      "properties": {
        "adopt": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "konnect"
              ]
            },
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "match",
                "override"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.from == oldSelf.from",
              "message": "'from'(adopt source) is immutable"
            },
            {
              "rule": "self.from == 'konnect' ? has(self.konnect) : true",
              "message": "Must specify Konnect options when from='konnect'"
            },
            {
              "rule": "has(self.konnect) ? (self.konnect.id == oldSelf.konnect.id) : true",
              "message": "konnect.id is immutable"
            }
          ]
        },
        "awsTransitGateway": {
          "type": "object",
          "required": [
            "attachment_config",
            "cidr_blocks",
            "name"
          ],
          "properties": {
            "attachment_config": {
              "type": "object",
              "required": [
                "ram_share_arn"
              ],
              "properties": {
                "ram_share_arn": {
                  "type": "string",
                  "minLength": 1
                },
                "transit_gateway_id": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "cidr_blocks": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "dns_config": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "domain_proxy_list",
                  "remote_dns_server_ip_addresses"
                ],
                "properties": {
                  "domain_proxy_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "remote_dns_server_ip_addresses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "name": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "azureTransitGateway": {
          "type": "object",
          "required": [
            "attachment_config",
            "name"
          ],
          "properties": {
            "attachment_config": {
              "type": "object",
              "required": [
                "resource_group_name",
                "subscription_id",
                "tenant_id",
                "vnet_name"
              ],
              "properties": {
                "resource_group_name": {
                  "type": "string",
                  "minLength": 1
                },
                "subscription_id": {
                  "type": "string",
                  "minLength": 1
                },
                "tenant_id": {
                  "type": "string",
                  "minLength": 1
                },
                "vnet_name": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "dns_config": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "domain_proxy_list",
                  "remote_dns_server_ip_addresses"
                ],
                "properties": {
                  "domain_proxy_list": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "remote_dns_server_ip_addresses": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "name": {
              "type": "string",
              "maxLength": 120,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "networkRef": {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "konnectID": {
              "type": "string",
              "maxLength": 36
            },
            "namespacedRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "type": {
              "type": "string",
              "enum": [
                "konnectID",
                "namespacedRef"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.type == 'namespacedRef' ? has(self.namespacedRef) : true",
              "message": "when type is namespacedRef, namespacedRef must be set"
            },
            {
              "rule": "self.type == 'namespacedRef' ? !has(self.konnectID) : true",
              "message": "when type is namespacedRef, konnectID must not be set"
            },
            {
              "rule": "self.type == 'konnectID' ? has(self.konnectID) : true",
              "message": "when type is konnectID, konnectID must be set"
            },
            {
              "rule": "self.type == 'konnectID' ? !has(self.namespacedRef) : true",
              "message": "when type is konnectID, namespacedRef must not be set"
            }
          ]
        },
        "type": {
          "type": "string",
          "enum": [
            "AWSTransitGateway",
            "AzureTransitGateway"
          ]
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "self.networkRef.type == 'namespacedRef'",
          "message": "only namespacedRef is supported currently"
        },
        {
          "rule": "self.type == oldSelf.type",
          "message": "spec.type is immutable"
        },
        {
          "rule": "self.type == 'AWSTransitGateway' ? has(self.awsTransitGateway) : true",
          "message": "must set spec.awsTransitGateway when spec.type is 'AWSTransitGateway'"
        },
        {
          "rule": "self.type != 'AWSTransitGateway' ? !has(self.awsTransitGateway) : true",
          "message": "must not set spec.awsTransitGateway when spec.type is not 'AWSTransitGateway'"
        },
        {
          "rule": "self.type == 'AzureTransitGateway' ? has(self.azureTransitGateway) : true",
          "message": "must set spec.azureTransitGateway when spec.type is 'AzureTransitGateway'"
        },
        {
          "rule": "self.type != 'AzureTransitGateway' ? !has(self.azureTransitGateway) : true",
          "message": "must not set spec.azureTransitGateway when spec.type is not 'AzureTransitGateway'"
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "default": [
            {
              "lastTransitionTime": "1970-01-01T00:00:00Z",
              "message": "Waiting for controller",
              "reason": "Pending",
              "status": "Unknown",
              "type": "Programmed"
            }
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "networkID": {
          "type": "string"
        },
        "organizationID": {
          "type": "string",
          "maxLength": 256
        },
        "serverURL": {
          "type": "string",
          "maxLength": 512
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "(!has(self.status) || !self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : (!has(self.spec.awsTransitGateway) ? true : oldSelf.spec.awsTransitGateway.name == self.spec.awsTransitGateway.name)",
      "message": "spec.awsTransitGateway.name is immutable when transit gateway is already Programmed"
    },
    {
      "rule": "(!has(self.status) || !self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : (!has(self.spec.azureTransitGateway) ? true : oldSelf.spec.azureTransitGateway.name == self.spec.azureTransitGateway.name)",
      "message": "spec.azureTransitGateway.name is immutable when transit gateway is already Programmed"
    }
  ]
}
