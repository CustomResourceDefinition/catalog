{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "konnect"
      ],
      "properties": {
        "apiSpec": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "description": {
              "type": "string",
              "maxLength": 512
            },
            "labels": {
              "type": "object",
              "maxProperties": 50,
              "additionalProperties": {
                "type": "string",
                "maxLength": 63,
                "minLength": 1,
                "pattern": "^[a-z0-9A-Z]{1}([a-z0-9A-Z-._]*[a-z0-9A-Z]+)?$"
              }
            },
            "minRuntimeVersion": {
              "type": "string",
              "maxLength": 253,
              "pattern": "^\\d+\\.\\d+$"
            },
            "name": {
              "type": "string",
              "maxLength": 255,
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "konnect": {
          "type": "object",
          "required": [
            "authRef"
          ],
          "properties": {
            "authRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "mirror": {
          "type": "object",
          "required": [
            "konnect"
          ],
          "properties": {
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{8}(?:\\-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "string",
          "default": "Origin",
          "enum": [
            "Origin",
            "Mirror"
          ]
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "!has(self.source) \u0026\u0026 !has(oldSelf.source) ? true : self.source == oldSelf.source",
          "message": "spec.source is immutable"
        },
        {
          "rule": "self.source != 'Mirror' || has(self.mirror)",
          "message": "mirror field must be set for type Mirror"
        },
        {
          "rule": "self.source != 'Origin' || !has(self.mirror)",
          "message": "mirror field cannot be set for type Origin"
        },
        {
          "rule": "self.source != 'Origin' || has(self.apiSpec)",
          "message": "apiSpec must be set for type Origin"
        },
        {
          "rule": "self.source != 'Mirror' || !has(self.apiSpec)",
          "message": "apiSpec cannot be set for type Mirror"
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "observedGeneration": {
          "type": "integer",
          "format": "int64"
        },
        "organizationID": {
          "type": "string",
          "maxLength": 256
        },
        "serverURL": {
          "type": "string",
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  }
}
