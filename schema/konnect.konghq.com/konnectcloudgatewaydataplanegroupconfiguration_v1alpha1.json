{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "controlPlaneRef",
        "version"
      ],
      "properties": {
        "adopt": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "konnect"
              ]
            },
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "match",
                "override"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.from == oldSelf.from",
              "message": "'from'(adopt source) is immutable"
            },
            {
              "rule": "self.from == 'konnect' ? has(self.konnect) : true",
              "message": "Must specify Konnect options when from='konnect'"
            },
            {
              "rule": "has(self.konnect) ? (self.konnect.id == oldSelf.konnect.id) : true",
              "message": "konnect.id is immutable"
            }
          ]
        },
        "api_access": {
          "type": "string",
          "default": "private+public",
          "enum": [
            "private",
            "public",
            "private+public"
          ]
        },
        "controlPlaneRef": {
          "type": "object",
          "properties": {
            "konnectNamespacedRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "type": {
              "type": "string",
              "default": "kic",
              "enum": [
                "konnectNamespacedRef",
                "kic"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'konnectNamespacedRef') ? has(self.konnectNamespacedRef) : true",
              "message": "when type is konnectNamespacedRef, konnectNamespacedRef must be set"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'kic') ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is kic, konnectNamespacedRef must not be set"
            },
            {
              "rule": "!has(self.type) ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is unset, konnectNamespacedRef must not be set"
            }
          ]
        },
        "dataplane_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "autoscale",
              "networkRef",
              "provider",
              "region"
            ],
            "properties": {
              "autoscale": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "autopilot": {
                    "type": "object",
                    "required": [
                      "base_rps"
                    ],
                    "properties": {
                      "base_rps": {
                        "type": "integer",
                        "format": "int64"
                      },
                      "max_rps": {
                        "type": "integer",
                        "format": "int64"
                      }
                    },
                    "additionalProperties": false
                  },
                  "static": {
                    "type": "object",
                    "required": [
                      "instance_type",
                      "requested_instances"
                    ],
                    "properties": {
                      "instance_type": {
                        "type": "string"
                      },
                      "requested_instances": {
                        "type": "integer",
                        "format": "int64"
                      }
                    },
                    "additionalProperties": false
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "static",
                      "autopilot"
                    ]
                  }
                },
                "additionalProperties": false,
                "x-kubernetes-validations": [
                  {
                    "rule": "!(has(self.autopilot) \u0026\u0026 has(self.static))",
                    "message": "can't provide both autopilot and static configuration"
                  },
                  {
                    "rule": "self.type == 'static' ? has(self.static) : true",
                    "message": "static is required when type is static"
                  },
                  {
                    "rule": "self.type == 'autopilot' ? has(self.autopilot) : true",
                    "message": "autopilot is required when type is autopilot"
                  }
                ]
              },
              "environment": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "name",
                    "value"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "maxLength": 63,
                      "minLength": 1,
                      "pattern": "^KONG_."
                    },
                    "value": {
                      "type": "string",
                      "maxLength": 63,
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "networkRef": {
                "type": "object",
                "required": [
                  "type"
                ],
                "properties": {
                  "konnectID": {
                    "type": "string",
                    "maxLength": 36
                  },
                  "namespacedRef": {
                    "type": "object",
                    "required": [
                      "name"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "maxLength": 253,
                        "minLength": 1
                      },
                      "namespace": {
                        "type": "string",
                        "maxLength": 253
                      }
                    },
                    "additionalProperties": false
                  },
                  "type": {
                    "type": "string",
                    "enum": [
                      "konnectID",
                      "namespacedRef"
                    ]
                  }
                },
                "additionalProperties": false,
                "x-kubernetes-validations": [
                  {
                    "rule": "self.type == 'namespacedRef' ? has(self.namespacedRef) : true",
                    "message": "when type is namespacedRef, namespacedRef must be set"
                  },
                  {
                    "rule": "self.type == 'namespacedRef' ? !has(self.konnectID) : true",
                    "message": "when type is namespacedRef, konnectID must not be set"
                  },
                  {
                    "rule": "self.type == 'konnectID' ? has(self.konnectID) : true",
                    "message": "when type is konnectID, konnectID must be set"
                  },
                  {
                    "rule": "self.type == 'konnectID' ? !has(self.namespacedRef) : true",
                    "message": "when type is konnectID, namespacedRef must not be set"
                  }
                ]
              },
              "provider": {
                "type": "string"
              },
              "region": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "!has(self.adopt) ? true : (has(self.controlPlaneRef) \u0026\u0026 self.controlPlaneRef.type == 'konnectNamespacedRef')",
          "message": "spec.adopt is allowed only when controlPlaneRef is konnectNamespacedRef"
        },
        {
          "rule": "(has(oldSelf.adopt) \u0026\u0026 has(self.adopt)) || (!has(oldSelf.adopt) \u0026\u0026 !has(self.adopt))",
          "message": "Cannot set or unset spec.adopt in updates"
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "default": [
            {
              "lastTransitionTime": "1970-01-01T00:00:00Z",
              "message": "Waiting for controller",
              "reason": "Pending",
              "status": "Unknown",
              "type": "Programmed"
            }
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "controlPlaneID": {
          "type": "string"
        },
        "dataplane_groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "cloud_gateway_network_id",
              "id",
              "provider",
              "region",
              "state"
            ],
            "properties": {
              "cloud_gateway_network_id": {
                "type": "string"
              },
              "egress_ip_addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "id": {
                "type": "string"
              },
              "private_ip_addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "provider": {
                "type": "string"
              },
              "region": {
                "type": "string"
              },
              "state": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "organizationID": {
          "type": "string",
          "maxLength": 256
        },
        "serverURL": {
          "type": "string",
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  }
}
