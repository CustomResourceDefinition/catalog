{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "controlPlaneRef",
        "mirror"
      ],
      "properties": {
        "controlPlaneRef": {
          "type": "object",
          "properties": {
            "konnectNamespacedRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "type": {
              "type": "string",
              "default": "kic",
              "enum": [
                "konnectNamespacedRef",
                "kic"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.type != 'konnectID'",
              "message": "'konnectID' type is not supported"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'konnectNamespacedRef') ? has(self.konnectNamespacedRef) : true",
              "message": "when type is konnectNamespacedRef, konnectNamespacedRef must be set"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'kic') ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is kic, konnectNamespacedRef must not be set"
            },
            {
              "rule": "!has(self.type) ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is unset, konnectNamespacedRef must not be set"
            }
          ]
        },
        "mirror": {
          "type": "object",
          "required": [
            "konnect"
          ],
          "properties": {
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1,
                  "pattern": "^[0-9a-f]{8}(?:\\-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "source": {
          "type": "string",
          "default": "Mirror",
          "enum": [
            "Mirror"
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "default": [
            {
              "lastTransitionTime": "1970-01-01T00:00:00Z",
              "message": "Waiting for controller",
              "reason": "Pending",
              "status": "Unknown",
              "type": "Programmed"
            }
          ],
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "controlPlaneID": {
          "type": "string"
        },
        "id": {
          "type": "string",
          "maxLength": 256
        },
        "konnectSpec": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "organizationID": {
          "type": "string",
          "maxLength": 256
        },
        "serverURL": {
          "type": "string",
          "maxLength": 512
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "oldSelf.spec.controlPlaneRef == self.spec.controlPlaneRef",
      "message": "spec.controlPlaneRef is immutable."
    }
  ]
}
