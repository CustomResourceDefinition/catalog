          "required": [
            "type"
          ],
          "properties": {
            "list": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "all",
                "list",
                "own"
