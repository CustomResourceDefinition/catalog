                "matchLabels": {
                  "type": "object",
                  "maxProperties": 8,
                  "additionalProperties": {
                    "type": "string"
                  },
                  "x-kubernetes-validations": [
                    {
                      "rule": "self.all(key,key.size() \u003e= 1)",
                      "message": "Minimum length of key in matchLabels is 1"
