                    {
                      "rule": "self.all(key,self[key].size() \u003c= 63)",
                      "message": "Maximum length of value in matchLabels is 63"
                    }
                  ]
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "watchNamespaces": {
          "type": "object",
          "default": {
