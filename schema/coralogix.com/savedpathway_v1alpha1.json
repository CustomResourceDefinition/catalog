{
  "description": "SavedPathway is the Schema for the savedpathways API.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "description": "APIVersion defines the versioned schema of this representation of an object.\nServers should convert recognized schemas to the latest internal value, and\nmay reject unrecognized values.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
      "type": "string"
    },
    "kind": {
      "description": "Kind is a string value representing the REST resource this object represents.\nServers may infer this from the endpoint the client submits requests to.\nCannot be updated.\nIn CamelCase.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "description": "SavedPathwaySpec defines the desired state of a SavedPathway.",
      "type": "object",
      "required": [
        "appName",
        "name",
        "timeRange",
        "view"
      ],
      "properties": {
        "appName": {
          "description": "RUM application the pathway belongs to.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1,
          "x-kubernetes-validations": [
            {
              "rule": "self == oldSelf",
              "message": "spec.appName is immutable"
            }
          ]
        },
        "direction": {
          "description": "Whether the paths show the pages after or before view.",
          "type": "string",
          "default": "after",
          "enum": [
            "after",
            "before"
          ]
        },
        "filters": {
          "description": "Session filters of the pathway. Empty when not set.",
          "type": "array",
          "maxItems": 100,
          "items": {
            "description": "SavedPathwayViewFilter is the ViewFilter object of the API.",
            "type": "object",
            "properties": {
              "boolFilter": {
                "description": "A boolean field with the value it must have.",
                "type": "object",
                "required": [
                  "field",
                  "value"
                ],
                "properties": {
                  "field": {
                    "description": "Boolean field to filter on. BOOL_FILTER_FIELD_UNSPECIFIED is rejected.",
                    "type": "string",
                    "enum": [
                      "hasSessionReplay",
                      "hasScreenshot",
                      "isRageClick",
                      "isDeadClick"
                    ]
                  },
                  "value": {
                    "description": "Value the field must have.",
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              },
              "numericFilter": {
                "description": "A numeric field with the condition it must match.",
                "type": "object",
                "required": [
                  "condition",
                  "field"
                ],
                "properties": {
                  "condition": {
                    "description": "Condition the field must match.",
                    "type": "object",
                    "properties": {
                      "max": {
                        "description": "Matches values less than or equal to max.",
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 1,
                        "pattern": "^-?[0-9]+$"
                      },
                      "min": {
                        "description": "Matches values greater than or equal to min.",
                        "type": "string",
                        "maxLength": 20,
                        "minLength": 1,
                        "pattern": "^-?[0-9]+$"
                      },
                      "range": {
                        "description": "Matches values from lower to upper, both included.",
                        "type": "object",
                        "required": [
                          "lower",
                          "upper"
                        ],
                        "properties": {
                          "lower": {
                            "description": "Lowest matching value, included. Must not be greater than upper.",
                            "type": "string",
                            "maxLength": 20,
                            "minLength": 1,
                            "pattern": "^-?[0-9]+$"
                          },
                          "upper": {
                            "description": "Highest matching value, included.",
                            "type": "string",
                            "maxLength": 20,
                            "minLength": 1,
                            "pattern": "^-?[0-9]+$"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false,
                    "x-kubernetes-validations": [
                      {
                        "rule": "(has(self.max) ? 1 : 0) + (has(self.min) ? 1 : 0) + (has(self.range) ? 1 : 0) == 1",
                        "message": "Exactly one of max, min, range must be set"
                      }
                    ]
                  },
                  "field": {
                    "description": "Numeric field to filter on. NUMERIC_FILTER_FIELD_UNSPECIFIED is rejected.",
                    "type": "string",
                    "enum": [
                      "errorCount",
                      "actionCount",
                      "longTaskCount",
                      "crashCount",
                      "resourceCount",
                      "scrollDepthPercentage",
                      "viewportWidth",
                      "viewportHeight",
                      "rageClickCount",
                      "deadClickCount"
                    ]
                  }
                },
                "additionalProperties": false
              },
              "stringFilter": {
                "description": "A string field with the condition it must match.",
                "type": "object",
                "required": [
                  "condition",
                  "field"
                ],
                "properties": {
                  "condition": {
                    "description": "Condition the field must match.",
                    "type": "object",
                    "required": [
                      "operator",
                      "values"
                    ],
                    "properties": {
                      "operator": {
                        "description": "Matching operator. STRING_CONDITION_OPERATOR_UNSPECIFIED is rejected.",
                        "type": "string",
                        "enum": [
                          "equal",
                          "notEqual",
                          "contains",
                          "notContains",
                          "startWith",
                          "notStartWith",
                          "endWith",
                          "notEndWith"
                        ]
                      },
                      "values": {
                        "description": "Values to match. At least one is required.",
                        "type": "array",
                        "maxItems": 100,
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "maxLength": 1024,
                          "minLength": 1
                        },
                        "x-kubernetes-list-type": "set"
                      }
                    },
                    "additionalProperties": false
                  },
                  "field": {
                    "description": "String field to filter on. STRING_FILTER_FIELD_UNSPECIFIED is rejected.",
                    "type": "string",
                    "enum": [
                      "urlSchema",
                      "urlSubdomain",
                      "urlDomain",
                      "urlHost",
                      "urlPath",
                      "urlTemplate",
                      "referrerSchema",
                      "referrerSubdomain",
                      "referrerDomain",
                      "referrerHost",
                      "referrerPath",
                      "referrerUrl",
                      "sessionId",
                      "userId",
                      "userEmail",
                      "userName",
                      "cxUserId",
                      "accountId",
                      "accountName",
                      "viewId",
                      "platform",
                      "environment",
                      "appVersion",
                      "cxSdkVersion",
                      "browserName",
                      "browserVersion",
                      "browserMajorVersion",
                      "os",
                      "osMajorVersion",
                      "osVersion",
                      "deviceType",
                      "deviceName",
                      "deviceBrand",
                      "deviceModel",
                      "deviceArchitecture",
                      "countryName",
                      "cityName",
                      "continentName",
                      "ip",
                      "userAgent",
                      "appName",
                      "clicksElementFingerprint"
                    ]
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false,
            "x-kubernetes-validations": [
              {
                "rule": "(has(self.boolFilter) ? 1 : 0) + (has(self.numericFilter) ? 1 : 0) + (has(self.stringFilter) ? 1 : 0) == 1",
                "message": "Exactly one of boolFilter, numericFilter, stringFilter must be set"
              }
            ]
          }
        },
        "name": {
          "description": "Display name of the pathway. Does not have to be unique.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        },
        "pagesCount": {
          "description": "Number of pages after or before view in each path.",
          "type": "integer",
          "format": "int32",
          "default": 5,
          "maximum": 2147483647,
          "minimum": 1
        },
        "timeRange": {
          "description": "Time range of the pathway.",
          "type": "object",
          "properties": {
            "calendar": {
              "description": "Named calendar window, resolved in the viewer's timezone. CALENDAR_WINDOW_UNSPECIFIED is rejected.",
              "type": "string",
              "enum": [
                "today",
                "yesterday"
              ]
            },
            "fixed": {
              "description": "Absolute time range between two timestamps.",
              "type": "object",
              "required": [
                "fromTimestampMs",
                "toTimestampMs"
              ],
              "properties": {
                "fromTimestampMs": {
                  "description": "Start of the range, in Unix milliseconds. Inclusive: events at exactly this time are in the range.",
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 1,
                  "pattern": "^[1-9][0-9]{0,18}$"
                },
                "toTimestampMs": {
                  "description": "End of the range, in Unix milliseconds. Exclusive: events at exactly this time are not in the range, so consecutive ranges can share a boundary.",
                  "type": "string",
                  "maxLength": 20,
                  "minLength": 1,
                  "pattern": "^[1-9][0-9]{0,18}$"
                }
              },
              "additionalProperties": false
            },
            "relativeMinutes": {
              "description": "Number of minutes back from now.",
              "type": "string",
              "maxLength": 20,
              "minLength": 1,
              "pattern": "^[1-9][0-9]{0,18}$"
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "(has(self.calendar) ? 1 : 0) + (has(self.fixed) ? 1 : 0) + (has(self.relativeMinutes) ? 1 : 0) == 1",
              "message": "Exactly one of calendar, fixed, relativeMinutes must be set"
            }
          ]
        },
        "topN": {
          "description": "Number of paths shown, most common first.",
          "type": "integer",
          "format": "int32",
          "default": 20,
          "maximum": 2147483647,
          "minimum": 1
        },
        "view": {
          "description": "View (page) the paths are traced from.",
          "type": "string",
          "maxLength": 1024,
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "status": {
      "description": "SavedPathwayStatus defines the observed state of a SavedPathway.",
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "description": "Condition contains details for one aspect of the current state of this API Resource.",
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "description": "lastTransitionTime is the last time the condition transitioned from one status to another.\nThis should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable.",
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "description": "message is a human readable message indicating details about the transition.\nThis may be an empty string.",
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "description": "observedGeneration represents the .metadata.generation that the condition was set based upon.\nFor instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date\nwith respect to the current state of the instance.",
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "description": "reason contains a programmatic identifier indicating the reason for the condition's last transition.\nProducers of specific condition types may define expected values and meanings for this field,\nand whether the values are considered a guaranteed API.\nThe value should be a CamelCase string.\nThis field may not be empty.",
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "description": "status of the condition, one of True, False, Unknown.",
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "description": "type of condition in CamelCase or in foo.example.com/CamelCase.",
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          }
        },
        "id": {
          "type": "string"
        },
        "printableStatus": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
