{
  "description": "See also https://coralogix.com/docs/user-guides/monitoring-and-insights/events2metrics/\n\n**Added in v0.5.0**\nEvents2Metric is the Schema for the events2metrics API.",
  "type": "object",
  "properties": {
    "apiVersion": {
      "description": "APIVersion defines the versioned schema of this representation of an object.\nServers should convert recognized schemas to the latest internal value, and\nmay reject unrecognized values.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
      "type": "string"
    },
    "kind": {
      "description": "Kind is a string value representing the REST resource this object represents.\nServers may infer this from the endpoint the client submits requests to.\nCannot be updated.\nIn CamelCase.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "description": "Events2MetricSpec defines the desired state of Events2Metric.",
      "type": "object",
      "required": [
        "name",
        "query"
      ],
      "properties": {
        "dataSource": {
          "description": "Data source in \u003cnamespace\u003e/\u003cdataset_name\u003e format. If not set, defaults to the standard logs/spans stream.",
          "type": "string"
        },
        "description": {
          "description": "Description of the E2M",
          "type": "string"
        },
        "metricFields": {
          "description": "E2M metric fields",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceField",
              "targetBaseMetricName"
            ],
            "properties": {
              "aggregations": {
                "description": "Represents Aggregation type list",
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "aggMetadata",
                    "aggType",
                    "enabled",
                    "targetMetricName"
                  ],
                  "properties": {
                    "aggMetadata": {
                      "description": "Aggregate metadata, samples or histogram type. Only relevant for the samples and histogram\naggregation types; leave both samples and histogram unset for min/max/count/avg/sum.",
                      "type": "object",
                      "properties": {
                        "histogram": {
                          "description": "E2M aggregate histogram type metadata",
                          "type": "object",
                          "required": [
                            "buckets"
                          ],
                          "properties": {
                            "buckets": {
                              "description": "Buckets of the E2M",
                              "type": "array",
                              "items": {
                                "pattern": "^(\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))(([KMGTPE]i)|[numkMGTPE]|([eE](\\+|-)?(([0-9]+(\\.[0-9]*)?)|(\\.[0-9]+))))?$",
                                "anyOf": [
                                  {
                                    "type": "integer"
                                  },
                                  {
                                    "type": "string"
                                  }
                                ],
                                "x-kubernetes-int-or-string": true
                              }
                            }
                          },
                          "additionalProperties": false
                        },
                        "samples": {
                          "description": "E2M sample type metadata",
                          "type": "object",
                          "required": [
                            "sampleType"
                          ],
                          "properties": {
                            "sampleType": {
                              "description": "E2MAggSamplesSampleType defines the type of sample aggregation to be performed.",
                              "type": "string",
                              "enum": [
                                "min",
                                "max"
                              ]
                            }
                          },
                          "additionalProperties": false
                        }
                      },
                      "additionalProperties": false,
                      "x-kubernetes-validations": [
                        {
                          "rule": "!(has(self.samples) \u0026\u0026 has(self.histogram))",
                          "message": "At most one of samples or histogram may be set"
                        }
                      ]
                    },
                    "aggType": {
                      "description": "Aggregation type",
                      "type": "string",
                      "enum": [
                        "min",
                        "max",
                        "count",
                        "avg",
                        "sum",
                        "histogram",
                        "samples"
                      ]
                    },
                    "enabled": {
                      "description": "Is enabled. True by default",
                      "type": "boolean",
                      "default": true
                    },
                    "targetMetricName": {
                      "description": "Target metric field alias name",
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "sourceField": {
                "description": "Source field",
                "type": "string"
              },
              "targetBaseMetricName": {
                "description": "Target metric field alias name",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "metricLabels": {
          "description": "E2M metric labels",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "sourceField",
              "targetLabel"
            ],
            "properties": {
              "sourceField": {
                "description": "Metric label source field",
                "type": "string"
              },
              "targetLabel": {
                "description": "Metric label target alias name",
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "name": {
          "description": "Name of the E2M",
          "type": "string"
        },
        "permutationsLimit": {
          "description": "Represents the limit of the permutations",
          "type": "integer",
          "format": "int32"
        },
        "query": {
          "description": "Spans or logs type query",
          "type": "object",
          "properties": {
            "logs": {
              "description": "Logs query for logs2metrics E2M",
              "type": "object",
              "properties": {
                "alias": {
                  "description": "alias",
                  "type": "string"
                },
                "applicationNameFilters": {
                  "description": "application name filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lucene": {
                  "description": "lucene query",
                  "type": "string"
                },
                "severityFilters": {
                  "description": "severity type filters",
                  "type": "array",
                  "items": {
                    "description": "L2MSeverity defines the severity type for logs2metrics E2M.",
                    "type": "string",
                    "enum": [
                      "debug",
                      "verbose",
                      "info",
                      "warn",
                      "error",
                      "critical"
                    ]
                  }
                },
                "subsystemNameFilters": {
                  "description": "subsystem names filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            },
            "spans": {
              "description": "Spans query for spans2metrics E2M",
              "type": "object",
              "properties": {
                "actionFilters": {
                  "description": "action filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "applicationNameFilters": {
                  "description": "application name filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "lucene": {
                  "description": "lucene query",
                  "type": "string"
                },
                "serviceFilters": {
                  "description": "service filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "subsystemNameFilters": {
                  "description": "subsystem name filters",
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "has(self.spans) != has(self.logs)",
              "message": "Exactly one of spans or logs must be set"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "description": "Events2MetricStatus defines the observed state of Events2Metric.",
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "description": "Condition contains details for one aspect of the current state of this API Resource.",
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "description": "lastTransitionTime is the last time the condition transitioned from one status to another.\nThis should be when the underlying condition changed.  If that is not known, then using the time when the API field changed is acceptable.",
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "description": "message is a human readable message indicating details about the transition.\nThis may be an empty string.",
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "description": "observedGeneration represents the .metadata.generation that the condition was set based upon.\nFor instance, if .metadata.generation is currently 12, but the .status.conditions[x].observedGeneration is 9, the condition is out of date\nwith respect to the current state of the instance.",
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "description": "reason contains a programmatic identifier indicating the reason for the condition's last transition.\nProducers of specific condition types may define expected values and meanings for this field,\nand whether the values are considered a guaranteed API.\nThe value should be a CamelCase string.\nThis field may not be empty.",
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "description": "status of the condition, one of True, False, Unknown.",
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "description": "type of condition in CamelCase or in foo.example.com/CamelCase.",
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          }
        },
        "id": {
          "type": "string"
        },
        "printableStatus": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
