{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "properties": {
        "kafkaClusterRef": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "Kafka",
                "LogicalKafkaCluster"
              ]
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "kafkaRest": {
          "type": "object",
          "properties": {
            "authentication": {
              "type": "object",
              "required": [
                "type"
              ],
              "properties": {
                "basic": {
                  "type": "object",
                  "properties": {
                    "debug": {
                      "type": "boolean"
                    },
                    "directoryPathInContainer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "ignoreRoles": {
                      "type": "boolean"
                    },
                    "restrictedRoles": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "string"
                      }
                    },
                    "roles": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "secretRef": {
                      "type": "string",
                      "maxLength": 30,
                      "minLength": 1,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  },
                  "additionalProperties": false
                },
                "bearer": {
                  "type": "object",
                  "properties": {
                    "directoryPathInContainer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "secretRef": {
                      "type": "string",
                      "maxLength": 30,
                      "minLength": 1,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  },
                  "additionalProperties": false
                },
                "oauth": {
                  "type": "object",
                  "required": [
                    "configuration"
                  ],
                  "properties": {
                    "configuration": {
                      "type": "object",
                      "properties": {
                        "audience": {
                          "type": "string",
                          "minLength": 1
                        },
                        "clientAssertion": {
                          "type": "object",
                          "properties": {
                            "clientId": {
                              "type": "string",
                              "minLength": 1
                            },
                            "jwtTokenFile": {
                              "type": "object",
                              "properties": {
                                "directoryPathInContainer": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "secretRef": {
                                  "type": "string",
                                  "maxLength": 30,
                                  "minLength": 1,
                                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                                }
                              },
                              "additionalProperties": false
                            },
                            "localClientAssertion": {
                              "type": "object",
                              "properties": {
                                "audience": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "includeJtiClaim": {
                                  "type": "boolean"
                                },
                                "includeNbfClaim": {
                                  "type": "boolean"
                                },
                                "issuer": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "privateKeyFile": {
                                  "type": "object",
                                  "properties": {
                                    "directoryPathInContainer": {
                                      "type": "string",
                                      "minLength": 1
                                    },
                                    "encryptedPrivateKey": {
                                      "type": "boolean"
                                    },
                                    "includeAssertionTemplate": {
                                      "type": "boolean"
                                    },
                                    "secretRef": {
                                      "type": "string",
                                      "maxLength": 30,
                                      "minLength": 1,
                                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                                    }
                                  },
                                  "additionalProperties": false
                                },
                                "subject": {
                                  "type": "string",
                                  "minLength": 1
                                },
                                "tokenLifetime": {
                                  "type": "integer",
                                  "format": "int32"
                                }
                              },
                              "additionalProperties": false
                            }
                          },
                          "additionalProperties": false
                        },
                        "expectedIssuer": {
                          "type": "string",
                          "minLength": 1
                        },
                        "groupsClaimName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "jwksEndpointUri": {
                          "type": "string",
                          "minLength": 1
                        },
                        "loginConnectTimeoutMs": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "loginReadTimeoutMs": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "loginRetryBackoffMaxMs": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "loginRetryBackoffMs": {
                          "type": "integer",
                          "format": "int32"
                        },
                        "scope": {
                          "type": "string",
                          "minLength": 1
                        },
                        "subClaimName": {
                          "type": "string",
                          "minLength": 1
                        },
                        "tokenEndpointUri": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "additionalProperties": false
                    },
                    "directoryPathInContainer": {
                      "type": "string",
                      "minLength": 1
                    },
                    "secretRef": {
                      "type": "string",
                      "maxLength": 30,
                      "minLength": 1,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  },
                  "additionalProperties": false
                },
                "sslClientAuthentication": {
                  "type": "boolean"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "basic",
                    "bearer",
                    "mtls",
                    "oauth"
                  ]
                }
              },
              "additionalProperties": false
            },
            "endpoint": {
              "type": "string",
              "minLength": 1,
              "pattern": "^https?://.*"
            },
            "kafkaClusterID": {
              "type": "string",
              "minLength": 1
            },
            "tls": {
              "type": "object",
              "properties": {
                "directoryPathInContainer": {
                  "type": "string",
                  "minLength": 1
                },
                "jksPassword": {
                  "type": "object",
                  "required": [
                    "secretRef"
                  ],
                  "properties": {
                    "secretRef": {
                      "type": "string",
                      "maxLength": 30,
                      "minLength": 1,
                      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                    }
                  },
                  "additionalProperties": false
                },
                "secretRef": {
                  "type": "string",
                  "maxLength": 63,
                  "minLength": 1,
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "kafkaRestClassRef": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "namespace": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "limits": {
          "type": "object",
          "properties": {
            "maxMessageSizeBytes": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "maxPartitions": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$",
          "x-kubernetes-validations": [
            {
              "rule": "self == oldSelf",
              "message": "name is immutable"
            }
          ]
        },
        "quotas": {
          "type": "object",
          "properties": {
            "brokerRequestThreads": {
              "type": "number",
              "minimum": 0,
              "exclusiveMinimum": true
            },
            "egressByteRate": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "ingressByteRate": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "!(has(self.kafkaRestClassRef) \u0026\u0026 has(self.kafkaRest))",
          "message": "kafkaRestClassRef and kafkaRest are mutually exclusive"
        }
      ]
    },
    "status": {
      "type": "object",
      "properties": {
        "bootstrapEndpoint": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "lastProbeTime": {
                "type": "string",
                "format": "date-time"
              },
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "creationDate": {
          "type": "string",
          "format": "date-time"
        },
        "deletionDate": {
          "type": "string",
          "format": "date-time"
        },
        "internalBootstrapEndpoint": {
          "type": "string"
        },
        "kafkaCluster": {
          "type": "string"
        },
        "kafkaClusterID": {
          "type": "string"
        },
        "logicalClusterID": {
          "type": "string"
        },
        "mdsEndpoint": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "observedGeneration": {
          "type": "integer",
          "format": "int64"
        },
        "phase": {
          "type": "string",
          "enum": [
            "Running",
            "Deactivated"
          ]
        },
        "state": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "!((has(self.spec.name) ? self.spec.name : self.metadata.name).matches('^lkc-.*-external$'))",
      "message": "the tenant name (spec.name, or metadata.name when spec.name is unset) must not match lkc-*-external; names of that form are reserved for tenants' EXTERNAL listener entries in the MDS Cluster Registry"
    }
  ]
}
