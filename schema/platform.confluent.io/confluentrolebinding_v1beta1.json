        {
          "rule": "!has(self.kafkaClusterRef) || !has(self.clustersScopeByRegistryName)",
          "message": "kafkaClusterRef and clustersScopeByRegistryName cannot both be set: a cluster registry name selects the whole scope, leaving the referenced cluster with no effect"
        },
        {
          "rule": "!has(self.kafkaClusterRef) || !has(self.clustersScopeByIds) || !has(self.clustersScopeByIds.cmfId)",
          "message": "kafkaClusterRef and clustersScopeByIds.cmfId cannot both be set: a CMF scope replaces the Kafka cluster scope, leaving the referenced cluster with no effect"
        },
        {
          "rule": "!has(self.kafkaClusterRef) || !has(self.clustersScopeByIds) || !has(self.clustersScopeByIds.kafkaClusterId)",
          "message": "kafkaClusterRef and clustersScopeByIds.kafkaClusterId cannot both be set: both declare the Kafka cluster scope, so set exactly one"
        }
      ]
    },
