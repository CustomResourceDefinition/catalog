{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "controlPlaneRef",
        "pluginRef"
      ],
      "properties": {
        "adopt": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "konnect"
              ]
            },
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "match",
                "override"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.from == oldSelf.from",
              "message": "'from'(adopt source) is immutable"
            },
            {
              "rule": "self.from == 'konnect' ? has(self.konnect) : true",
              "message": "Must specify Konnect options when from='konnect'"
            },
            {
              "rule": "has(self.konnect) ? (self.konnect.id == oldSelf.konnect.id) : true",
              "message": "konnect.id is immutable"
            }
          ]
        },
        "controlPlaneRef": {
          "type": "object",
          "properties": {
            "konnectNamespacedRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "type": {
              "type": "string",
              "default": "kic",
              "enum": [
                "konnectNamespacedRef",
                "kic"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.type != 'konnectID'",
              "message": "'konnectID' type is not supported"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'konnectNamespacedRef') ? has(self.konnectNamespacedRef) : true",
              "message": "when type is konnectNamespacedRef, konnectNamespacedRef must be set"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'kic') ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is kic, konnectNamespacedRef must not be set"
            },
            {
              "rule": "!has(self.type) ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is unset, konnectNamespacedRef must not be set"
            }
          ]
        },
        "pluginRef": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "default": "KongPlugin",
              "enum": [
                "KongPlugin",
                "KongClusterPlugin"
              ]
            },
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.name != ''",
              "message": "pluginRef name must be set"
            },
            {
              "rule": "self.kind == 'KongPlugin' || !has(self.__namespace__)",
              "message": "Namespace can be set only when kind is 'KongPlugin'"
            }
          ]
        },
        "scope": {
          "type": "string",
          "default": "OnlyTargets",
          "enum": [
            "OnlyTargets",
            "GlobalInControlPlane"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          },
          "x-kubernetes-validations": [
            {
              "rule": "self.all(tag, size(tag) \u003e= 1 \u0026\u0026 size(tag) \u003c= 128)",
              "message": "tags entries must not be longer than 128 characters"
            },
            {
              "rule": "self.all(tag, !tag.startsWith('k8s-group:') \u0026\u0026 !tag.startsWith('k8s-version:') \u0026\u0026 !tag.startsWith('k8s-kind:') \u0026\u0026 !tag.startsWith('k8s-namespace:') \u0026\u0026 !tag.startsWith('k8s-name:') \u0026\u0026 !tag.startsWith('k8s-uid:') \u0026\u0026 !tag.startsWith('k8s-generation:') \u0026\u0026 !tag.startsWith('managed-by:'))",
              "message": "tags entries must not start with reserved prefixes: k8s-group:, k8s-version:, k8s-kind:, k8s-namespace:, k8s-name:, k8s-uid:, k8s-generation:, managed-by:"
            }
          ]
        },
        "targets": {
          "type": "object",
          "properties": {
            "consumerGroupRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "consumerRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "routeRef": {
              "type": "object",
              "required": [
                "group",
                "kind",
                "name"
              ],
              "properties": {
                "group": {
                  "type": "string",
                  "enum": [
                    "",
                    "core",
                    "networking.k8s.io",
                    "gateway.networking.k8s.io",
                    "configuration.konghq.com"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Service",
                    "Ingress",
                    "HTTPRoute",
                    "GRPCRoute",
                    "KongService",
                    "KongRoute"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "x-kubernetes-validations": [
                {
                  "rule": "(self.kind == 'KongRoute' \u0026\u0026 self.group == 'configuration.konghq.com') || (self.kind == 'Ingress' \u0026\u0026 self.group == 'networking.k8s.io') || (self.kind == 'HTTPRoute' \u0026\u0026 self.group == 'gateway.networking.k8s.io') || (self.kind == 'GRPCRoute' \u0026\u0026 self.group == 'gateway.networking.k8s.io')",
                  "message": "group/kind not allowed for the routeRef"
                }
              ]
            },
            "serviceRef": {
              "type": "object",
              "required": [
                "group",
                "kind",
                "name"
              ],
              "properties": {
                "group": {
                  "type": "string",
                  "enum": [
                    "",
                    "core",
                    "networking.k8s.io",
                    "gateway.networking.k8s.io",
                    "configuration.konghq.com"
                  ]
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "Service",
                    "Ingress",
                    "HTTPRoute",
                    "GRPCRoute",
                    "KongService",
                    "KongRoute"
                  ]
                },
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "x-kubernetes-validations": [
                {
                  "rule": "(self.kind == 'KongService' \u0026\u0026 self.group == 'configuration.konghq.com') || (self.kind == 'Service' \u0026\u0026 (self.group == '' || self.group == 'core'))",
                  "message": "group/kind not allowed for the serviceRef"
                }
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "(has(self.consumerRef) ? !has(self.consumerGroupRef) : true)",
              "message": "Cannot set Consumer and ConsumerGroup at the same time"
            },
            {
              "rule": "(has(self.routeRef) \u0026\u0026 self.routeRef.kind == 'KongRoute') ? (!has(self.serviceRef) || self.serviceRef.kind == 'KongService') : true",
              "message": "KongRoute can be used only when serviceRef is unset or set to KongService"
            },
            {
              "rule": "(has(self.serviceRef) \u0026\u0026 self.serviceRef.kind == 'KongService') ? (!has(self.routeRef) || self.routeRef.kind == 'KongRoute') : true",
              "message": "KongService can be used only when routeRef is unset or set to KongRoute"
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "self.scope == 'OnlyTargets' ? has(self.targets) \u0026\u0026 (has(self.targets.routeRef) || has(self.targets.serviceRef) || has(self.targets.consumerRef) || has(self.targets.consumerGroupRef)) : true",
          "message": "At least one target reference must be set when scope is 'OnlyTargets'"
        },
        {
          "rule": "self.scope == 'GlobalInControlPlane' ? !has(self.targets) : true",
          "message": "No targets must be set when scope is 'GlobalInControlPlane'"
        },
        {
          "rule": "!has(self.adopt) ? true : (has(self.controlPlaneRef) \u0026\u0026 self.controlPlaneRef.type == 'konnectNamespacedRef')",
          "message": "spec.adopt is allowed only when controlPlaneRef is konnectNamespacedRef"
        },
        {
          "rule": "(has(oldSelf.adopt) \u0026\u0026 has(self.adopt)) || (!has(oldSelf.adopt) \u0026\u0026 !has(self.adopt))",
          "message": "Cannot set or unset spec.adopt in updates"
        }
      ]
    },
    "status": {
      "type": "object",
      "default": {
        "conditions": [
          {
            "lastTransitionTime": "1970-01-01T00:00:00Z",
            "message": "Waiting for controller",
            "reason": "Pending",
            "status": "Unknown",
            "type": "Programmed"
          }
        ]
      },
      "properties": {
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "konnect": {
          "type": "object",
          "properties": {
            "controlPlaneID": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "maxLength": 256
            },
            "organizationID": {
              "type": "string",
              "maxLength": 256
            },
            "serverURL": {
              "type": "string",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "!has(oldSelf.spec.controlPlaneRef) || has(self.spec.controlPlaneRef)",
      "message": "controlPlaneRef is required once set"
    },
    {
      "rule": "(!self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : oldSelf.spec.controlPlaneRef == self.spec.controlPlaneRef",
      "message": "spec.controlPlaneRef is immutable when an entity is already Programmed"
    }
  ]
}
