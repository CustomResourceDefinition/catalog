{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "consumerRef"
      ],
      "properties": {
        "adopt": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "konnect"
              ]
            },
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "match",
                "override"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.from == oldSelf.from",
              "message": "'from'(adopt source) is immutable"
            },
            {
              "rule": "self.from == 'konnect' ? has(self.konnect) : true",
              "message": "Must specify Konnect options when from='konnect'"
            },
            {
              "rule": "has(self.konnect) ? (self.konnect.id == oldSelf.konnect.id) : true",
              "message": "konnect.id is immutable"
            }
          ]
        },
        "algorithm": {
          "type": "string",
          "default": "HS256",
          "enum": [
            "HS256",
            "HS384",
            "HS512",
            "RS256",
            "RS384",
            "RS512",
            "ES256",
            "ES384",
            "ES512",
            "PS256",
            "PS384",
            "PS512",
            "EdDSA"
          ]
        },
        "consumerRef": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "default": ""
            }
          },
          "additionalProperties": false,
          "x-kubernetes-map-type": "atomic"
        },
        "id": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "rsa_public_key": {
          "type": "string"
        },
        "secret": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          },
          "x-kubernetes-validations": [
            {
              "rule": "self.all(tag, size(tag) \u003e= 1 \u0026\u0026 size(tag) \u003c= 128)",
              "message": "tags entries must not be longer than 128 characters"
            },
            {
              "rule": "self.all(tag, !tag.startsWith('k8s-group:') \u0026\u0026 !tag.startsWith('k8s-version:') \u0026\u0026 !tag.startsWith('k8s-kind:') \u0026\u0026 !tag.startsWith('k8s-namespace:') \u0026\u0026 !tag.startsWith('k8s-name:') \u0026\u0026 !tag.startsWith('k8s-uid:') \u0026\u0026 !tag.startsWith('k8s-generation:') \u0026\u0026 !tag.startsWith('managed-by:'))",
              "message": "tags entries must not start with reserved prefixes: k8s-group:, k8s-version:, k8s-kind:, k8s-namespace:, k8s-name:, k8s-uid:, k8s-generation:, managed-by:"
            }
          ]
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "(has(oldSelf.adopt) \u0026\u0026 has(self.adopt)) || (!has(oldSelf.adopt) \u0026\u0026 !has(self.adopt))",
          "message": "Cannot set or unset spec.adopt in updates"
        }
      ]
    },
    "status": {
      "type": "object",
      "default": {
        "conditions": [
          {
            "lastTransitionTime": "1970-01-01T00:00:00Z",
            "message": "Waiting for controller",
            "reason": "Pending",
            "status": "Unknown",
            "type": "Programmed"
          }
        ]
      },
      "properties": {
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "konnect": {
          "type": "object",
          "properties": {
            "consumerID": {
              "type": "string"
            },
            "controlPlaneID": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "maxLength": 256
            },
            "organizationID": {
              "type": "string",
              "maxLength": 256
            },
            "serverURL": {
              "type": "string",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "(!self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : oldSelf.spec.consumerRef == self.spec.consumerRef",
      "message": "spec.consumerRef is immutable when an entity is already Programmed"
    },
    {
      "rule": "self.spec.algorithm in [ 'RS256','RS384','RS512','ES256','ES384','ES512','PS256','PS384','PS512','EdDSA', ] ? has(self.spec.rsa_public_key) : true",
      "message": "spec.rsa_public_key is required when algorithm is RS*, ES*, PS* or EdDSA*"
    }
  ]
}
