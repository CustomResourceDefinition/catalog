{
  "type": "object",
  "required": [
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "controlPlaneRef"
      ],
      "properties": {
        "adopt": {
          "type": "object",
          "required": [
            "from"
          ],
          "properties": {
            "from": {
              "type": "string",
              "enum": [
                "konnect"
              ]
            },
            "konnect": {
              "type": "object",
              "required": [
                "id"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "maxLength": 36,
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "mode": {
              "type": "string",
              "enum": [
                "match",
                "override"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.from == oldSelf.from",
              "message": "'from'(adopt source) is immutable"
            },
            {
              "rule": "self.from == 'konnect' ? has(self.konnect) : true",
              "message": "Must specify Konnect options when from='konnect'"
            },
            {
              "rule": "has(self.konnect) ? (self.konnect.id == oldSelf.konnect.id) : true",
              "message": "konnect.id is immutable"
            }
          ]
        },
        "cert": {
          "type": "string"
        },
        "controlPlaneRef": {
          "type": "object",
          "properties": {
            "konnectNamespacedRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "maxLength": 253,
                  "minLength": 1
                },
                "namespace": {
                  "type": "string",
                  "maxLength": 253
                }
              },
              "additionalProperties": false
            },
            "type": {
              "type": "string",
              "default": "kic",
              "enum": [
                "konnectNamespacedRef",
                "kic"
              ]
            }
          },
          "additionalProperties": false,
          "x-kubernetes-validations": [
            {
              "rule": "self.type != 'konnectID'",
              "message": "'konnectID' type is not supported"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'konnectNamespacedRef') ? has(self.konnectNamespacedRef) : true",
              "message": "when type is konnectNamespacedRef, konnectNamespacedRef must be set"
            },
            {
              "rule": "(has(self.type) \u0026\u0026 self.type == 'kic') ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is kic, konnectNamespacedRef must not be set"
            },
            {
              "rule": "!has(self.type) ? !has(self.konnectNamespacedRef) : true",
              "message": "when type is unset, konnectNamespacedRef must not be set"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "secretRef": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 253,
              "minLength": 1
            },
            "namespace": {
              "type": "string",
              "maxLength": 253
            }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          },
          "x-kubernetes-validations": [
            {
              "rule": "self.all(tag, size(tag) \u003e= 1 \u0026\u0026 size(tag) \u003c= 128)",
              "message": "tags entries must not be longer than 128 characters"
            },
            {
              "rule": "self.all(tag, !tag.startsWith('k8s-group:') \u0026\u0026 !tag.startsWith('k8s-version:') \u0026\u0026 !tag.startsWith('k8s-kind:') \u0026\u0026 !tag.startsWith('k8s-namespace:') \u0026\u0026 !tag.startsWith('k8s-name:') \u0026\u0026 !tag.startsWith('k8s-uid:') \u0026\u0026 !tag.startsWith('k8s-generation:') \u0026\u0026 !tag.startsWith('managed-by:'))",
              "message": "tags entries must not start with reserved prefixes: k8s-group:, k8s-version:, k8s-kind:, k8s-namespace:, k8s-name:, k8s-uid:, k8s-generation:, managed-by:"
            }
          ]
        },
        "type": {
          "type": "string",
          "default": "inline",
          "enum": [
            "inline",
            "secretRef"
          ]
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "!has(self.controlPlaneRef) ? true : self.controlPlaneRef.type != 'kic'",
          "message": "KIC is not supported as control plane"
        },
        {
          "rule": "!has(self.adopt) ? true : (has(self.controlPlaneRef) \u0026\u0026 self.controlPlaneRef.type == 'konnectNamespacedRef')",
          "message": "spec.adopt is allowed only when controlPlaneRef is konnectNamespacedRef"
        },
        {
          "rule": "(has(oldSelf.adopt) \u0026\u0026 has(self.adopt)) || (!has(oldSelf.adopt) \u0026\u0026 !has(self.adopt))",
          "message": "Cannot set or unset spec.adopt in updates"
        },
        {
          "rule": "self.type != 'inline' || (has(self.cert) \u0026\u0026 self.cert.size() != 0)",
          "message": "spec.cert is required when type is 'inline'"
        },
        {
          "rule": "self.type != 'secretRef' || has(self.secretRef)",
          "message": "spec.secretRef is required when type is 'secretRef'"
        },
        {
          "rule": "!(has(self.cert) \u0026\u0026 has(self.secretRef))",
          "message": "cert and secretRef cannot be set at the same time"
        }
      ]
    },
    "status": {
      "type": "object",
      "default": {
        "conditions": [
          {
            "lastTransitionTime": "1970-01-01T00:00:00Z",
            "message": "Waiting for controller",
            "reason": "Pending",
            "status": "Unknown",
            "type": "Programmed"
          }
        ]
      },
      "properties": {
        "conditions": {
          "type": "array",
          "maxItems": 8,
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "lastTransitionTime",
              "message",
              "reason",
              "status",
              "type"
            ],
            "properties": {
              "lastTransitionTime": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 32768
              },
              "observedGeneration": {
                "type": "integer",
                "format": "int64",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "maxLength": 1024,
                "minLength": 1,
                "pattern": "^[A-Za-z]([A-Za-z0-9_,:]*[A-Za-z0-9_])?$"
              },
              "status": {
                "type": "string",
                "enum": [
                  "True",
                  "False",
                  "Unknown"
                ]
              },
              "type": {
                "type": "string",
                "maxLength": 316,
                "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*/)?(([A-Za-z0-9][-A-Za-z0-9_.]*)?[A-Za-z0-9])$"
              }
            },
            "additionalProperties": false
          },
          "x-kubernetes-list-map-keys": [
            "type"
          ],
          "x-kubernetes-list-type": "map"
        },
        "konnect": {
          "type": "object",
          "properties": {
            "controlPlaneID": {
              "type": "string"
            },
            "id": {
              "type": "string",
              "maxLength": 256
            },
            "organizationID": {
              "type": "string",
              "maxLength": 256
            },
            "serverURL": {
              "type": "string",
              "maxLength": 512
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "x-kubernetes-validations": [
    {
      "rule": "!has(oldSelf.spec.controlPlaneRef) || has(self.spec.controlPlaneRef)",
      "message": "controlPlaneRef is required once set"
    },
    {
      "rule": "(!self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : oldSelf.spec.controlPlaneRef == self.spec.controlPlaneRef",
      "message": "spec.controlPlaneRef is immutable when an entity is already Programmed"
    },
    {
      "rule": "(!self.status.conditions.exists(c, c.type == 'Programmed' \u0026\u0026 c.status == 'True')) ? true : ((!has(oldSelf.spec.id) \u0026\u0026 !has(self.spec.id)) || (has(oldSelf.spec.id) \u0026\u0026 has(self.spec.id) \u0026\u0026 oldSelf.spec.id == self.spec.id))",
      "message": "spec.id is immutable when an entity is already Programmed"
    }
  ]
}
