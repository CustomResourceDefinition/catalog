                                    },
                                    "uid": {
                                      "type": "integer",
                                      "format": "int64"
                                    }
                                  },
                                  "additionalProperties": false
                                }
                              },
                              "format": {
                                "type": "string"
                              },
                              "point": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "raid": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "devices": {
                            "type": "array",
