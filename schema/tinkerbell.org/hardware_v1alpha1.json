                    },
                    "os_slug": {
                      "type": "string"
                    },
                    "slug": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "private_subnets": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
