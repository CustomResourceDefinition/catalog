{
  "type": "object",
  "properties": {
    "apiVersion": {
      "description": "APIVersion defines the versioned schema of this representation of an object.\nServers should convert recognized schemas to the latest internal value, and\nmay reject unrecognized values.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#resources",
      "type": "string"
    },
    "kind": {
      "description": "Kind is a string value representing the REST resource this object represents.\nServers may infer this from the endpoint the client submits requests to.\nCannot be updated.\nIn CamelCase.\nMore info: https://git.k8s.io/community/contributors/devel/sig-architecture/api-conventions.md#types-kinds",
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "description": "RenovateProjectSpec contains the immutable identity of the tracked repository.",
      "type": "object",
      "required": [
        "project"
      ],
      "properties": {
        "project": {
          "description": "Project is the full repository name as reported by the git platform (e.g. \"org/repo\").",
          "type": "string",
          "x-kubernetes-validations": [
            {
              "rule": "self == oldSelf",
              "message": "project is immutable"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "description": "RenovateProjectState captures the runtime status of one Renovate run for this repository.",
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "duration": {
          "type": "string"
        },
        "executionOptions": {
          "type": "object",
          "properties": {
            "debug": {
              "description": "If true, the renovate job will be executed with RENOVATE_LOG_LEVEL=debug",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "lastTransition": {
          "description": "LastTransition records when the project most recently changed state.",
          "type": "string",
          "format": "date-time"
        },
        "logIssues": {
          "description": "LogIssues contains aggregate counts and individual issue messages from a Renovate run.",
          "type": "object",
          "required": [
            "errorCount",
            "warnCount"
          ],
          "properties": {
            "errorCount": {
              "type": "integer"
            },
            "issues": {
              "type": "array",
              "items": {
                "description": "LogIssue represents a single warning or error from Renovate logs.",
                "type": "object",
                "required": [
                  "level",
                  "message"
                ],
                "properties": {
                  "level": {
                    "type": "integer"
                  },
                  "message": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "warnCount": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "prActivity": {
          "description": "PRActivity contains aggregate counts and individual details of PR activity from a run.",
          "type": "object",
          "required": [
            "automerged",
            "created",
            "needsApproval",
            "unchanged",
            "updated"
          ],
          "properties": {
            "automerged": {
              "type": "integer"
            },
            "created": {
              "type": "integer"
            },
            "needsApproval": {
              "type": "integer"
            },
            "prs": {
              "type": "array",
              "items": {
                "description": "PRDetail represents a single PR found in Renovate logs.",
                "type": "object",
                "required": [
                  "action",
                  "branch"
                ],
                "properties": {
                  "action": {
                    "description": "PRAction represents what happened to a PR in a Renovate run.",
                    "type": "string"
                  },
                  "branch": {
                    "type": "string"
                  },
                  "number": {
                    "type": "integer"
                  },
                  "title": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "truncated": {
              "type": "boolean"
            },
            "unchanged": {
              "type": "integer"
            },
            "updated": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "priority": {
          "type": "integer",
          "format": "int32"
        },
        "renovateResultStatus": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
