{
  "type": "object",
  "properties": {
    "apiVersion": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "spec": {
      "type": "object",
      "required": [
        "hostPort"
      ],
      "properties": {
        "apiKeySecretRef": {
          "type": "object",
          "required": [
            "key"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "default": ""
            },
            "optional": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "x-kubernetes-map-type": "atomic"
        },
        "hostPort": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9.-]+:[0-9]+$"
        },
        "mutualTLSSecretRef": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
            }
          },
          "additionalProperties": false
        },
        "tls": {
          "type": "object",
          "properties": {
            "caCertSecretRef": {
              "type": "object",
              "required": [
                "name"
              ],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
                }
              },
              "additionalProperties": false
            },
            "serverName": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9.-]+$"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "x-kubernetes-validations": [
        {
          "rule": "!(has(self.mutualTLSSecretRef) \u0026\u0026 has(self.apiKeySecretRef))",
          "message": "Only one of mutualTLSSecretRef or apiKeySecretRef may be set"
        },
        {
          "rule": "!(has(self.mutualTLSSecretRef) \u0026\u0026 has(self.tls) \u0026\u0026 has(self.tls.caCertSecretRef))",
          "message": "tls.caCertSecretRef cannot be combined with mutualTLSSecretRef; bundle the CA into that secret's own ca.crt key instead"
        }
      ]
    },
    "status": {
      "type": "object"
    }
  }
}
